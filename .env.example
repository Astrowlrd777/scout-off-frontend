# Stellar / Soroban
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

# IPFS / Pinata
PINATA_API_KEY=
PINATA_SECRET=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Shared rate limiter (lib/rateLimit.ts) — used by app/api/players/search
# and app/api/ipfs/upload to throttle requests per client IP.
#
# REQUIRED in production for the limiter to be globally authoritative.
# Serverless deployments (e.g. Vercel) run multiple warm instances of the
# same function behind a load balancer; without a shared store each
# instance would track its own counter, so a client spread across N
# instances could get roughly `limit * N` requests through instead of
# `limit`. Upstash Redis (REST-based, no persistent TCP connection needed)
# closes that gap by giving every instance the same counter.
#
# If these are left blank in production, the app does NOT fail — it logs a
# loud console.error once and falls back to an in-memory, per-instance
# limiter so routes keep working, but that fallback is best-effort only and
# is NOT an authoritative global limit. Treat "blank in production" as a
# misconfiguration to fix, not a supported long-term state.
#
# Local dev/test: leave these blank. lib/rateLimit.ts automatically falls
# back to the same in-memory limiter, which is fully sufficient for a
# single local process — no Upstash account needed to develop or run tests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Media proxy signed-URL secret (optional). When set, /api/media/[cid] enforces
# signed, time-limited URLs generated via lib/mediaUrlSigning.ts in addition to
# referrer gating. Leave blank locally — the proxy falls back to referrer-only
# gating when this is unset. Generate one with: openssl rand -hex 32
MEDIA_URL_SIGNING_SECRET=

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only override for SSR/Server Component fetches (e.g. Docker Compose's
# http://mock-api:4000 container-internal hostname). Leave blank outside of
# docker-compose.yml — lib/api.ts falls back to NEXT_PUBLIC_API_URL.
API_URL_INTERNAL=

# Cloudflare Turnstile — bot-protection challenge on unauthenticated public
# forms (e.g. referral code generation). Leave blank to disable the
# challenge locally; the server-side check is skipped when its secret is
# unset (see server/.env.example).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Indexer query API (packages/indexer)
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:3001

# Auth (SEP-10)
STELLAR_SECRET_KEY=
NEXT_PUBLIC_DOMAIN=localhost:3000

# Error monitoring (optional — leave blank to disable Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# Sentry release + source-map upload (build-time only, set as CI/host secrets —
# leave blank locally to skip the upload step during `next build`)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=

# Platform config
PLATFORM_CONTACT_FEE_XLM=1
NEXT_PUBLIC_ADMIN_ADDRESS=

# Public status page (free-tier provider e.g. Instatus, Better Stack, UptimeRobot)
# monitoring the frontend, backend API, and Soroban RPC/Horizon endpoints.
# Leave blank to hide the live-status link on the /status page.
NEXT_PUBLIC_STATUS_PAGE_URL=

# PWA / App URL (used for manifest start_url, OG tags, and sitemap generation)
NEXT_PUBLIC_APP_URL=https://scoutoff.app

# SEP-10 challenge server
SEP10_SERVER_KEY=
SEP10_HOME_DOMAIN=

# Runtime (set automatically by Next.js)
NODE_ENV=
PORT=
NEXT_PUBLIC_BASE_URL=
